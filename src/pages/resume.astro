---
/*
 * The demo's resume in the Marigold style: an art-book plate on rose, like the About chapter. Labels in a narrow
 * left column, content on the right, 1px ink hairlines between sections. Prints to one A4 page.
 * Content comes from src/data/resume.ts; empty fields are not rendered.
 */
import Star from '../components/Star.astro';
import StarSprite from '../components/StarSprite.astro';
import { profile } from '../data/profile';
import { resume } from '../data/resume';
import BaseLayout from '../layouts/BaseLayout.astro';

const contact = [
	{ text: resume.role },
	{ text: resume.location },
	{ text: profile.email, href: `mailto:${profile.email}` },
	{ text: 'GitHub', href: profile.github },
	{ text: 'LinkedIn', href: profile.linkedin },
].filter((c) => c.text && (c.href === undefined || c.href));
---

<BaseLayout title={`Resume — ${resume.fullName}`}>
	<StarSprite />
	<nav class="cv-bar" aria-label="Resume">
		<a class="micro cv-back" href="/">← Back to {profile.name}</a>
		<Star class="cv-mark" />
		<button class="btn cv-print" type="button" data-print>Save as PDF</button>
		<p class="micro cv-print-hint" role="status" data-print-hint hidden>
			The print dialog didn't open here. Press <kbd>⌘ P</kbd> (Mac) or <kbd>Ctrl P</kbd>, then choose "Save as PDF".
		</p>
	</nav>

	<main class="cv">
		<header class="cv-head">
			<h1 class="cv-name">{resume.fullName}<sup class="cv-years" aria-hidden="true">({profile.years})</sup></h1>
			<p class="micro cv-contact">
				{
					contact.map((c, i) => (
						<>
							{i > 0 && <span aria-hidden="true"> · </span>}
							{c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>}
						</>
					))
				}
			</p>
			{resume.summary && <p class="cv-summary">{resume.summary}</p>}
		</header>

		{
			resume.experience.length > 0 && (
				<section class="cv-sec" aria-labelledby="cv-experience">
					<h2 class="micro cv-label" id="cv-experience">Experience</h2>
					<div class="cv-body">
						{resume.experience.map((job) => (
							<article class="cv-item">
								<div class="cv-item-head">
									<h3 class="cv-item-title">
										{job.role}, {job.org}
									</h3>
									{job.dates && <p class="micro cv-dates">{job.dates}</p>}
								</div>
								{job.detail && <p class="cv-text">{job.detail}</p>}
								{job.points.length > 0 && (
									<ul class="cv-points">
										{job.points.map((p) => (
											<li>{p}</li>
										))}
									</ul>
								)}
							</article>
						))}
					</div>
				</section>
			)
		}

		{
			resume.education.length > 0 && (
				<section class="cv-sec" aria-labelledby="cv-education">
					<h2 class="micro cv-label" id="cv-education">Education</h2>
					<div class="cv-body">
						{resume.education.map((ed) => (
							<article class="cv-item">
								<div class="cv-item-head">
									<h3 class="cv-item-title">{ed.org}</h3>
									{ed.dates && <p class="micro cv-dates">{ed.dates}</p>}
								</div>
								{ed.role && <p class="cv-text">{ed.role}</p>}
							</article>
						))}
					</div>
				</section>
			)
		}

		{
			resume.skills.length > 0 && (
				<section class="cv-sec" aria-labelledby="cv-skills">
					<h2 class="micro cv-label" id="cv-skills">Skills</h2>
					<dl class="cv-body cv-skills">
						{resume.skills.map((s) => (
							<div class="cv-skill">
								<dt class="cv-item-title">{s.group}</dt>
								<dd class="cv-text">{s.items.join(' · ')}</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		{
			resume.languages && (
				<section class="cv-sec" aria-labelledby="cv-languages">
					<h2 class="micro cv-label" id="cv-languages">Languages</h2>
					<p class="cv-body cv-text">{resume.languages}</p>
				</section>
			)
		}

		{
			resume.interests && (
				<section class="cv-sec" aria-labelledby="cv-interests">
					<h2 class="micro cv-label" id="cv-interests">Interests</h2>
					<p class="cv-body cv-text">{resume.interests}</p>
				</section>
			)
		}
	</main>

	<script>
		import '../scripts/print';
	</script>
</BaseLayout>

<style>
	/* Rose, like the About chapter it continues. Print switches to white (below). */
	:global(html) {
		background: var(--rose);
	}
	.cv-bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 900px;
		margin: 0 auto;
		padding: 1.25rem 2rem;
	}
	.cv-back {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	.cv-bar :global(.cv-mark) {
		width: 40px;
		height: 40px;
	}
	.cv-print {
		justify-self: end;
	}
	/* Shown only if the print dialog was blocked; spans the bar under its three items. */
	.cv-print-hint {
		grid-column: 1 / -1;
		justify-self: end;
		max-width: 46ch;
		margin-top: 0.5rem;
		text-align: right;
	}
	.cv-print-hint[hidden] {
		display: none;
	}
	.cv-print-hint kbd {
		font: inherit;
		padding: 0.1em 0.4em;
		border: 1px solid var(--ink);
		border-radius: 4px;
	}

	.cv {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 2rem 5rem;
	}
	.cv-head {
		display: grid;
		gap: 1.25rem;
		padding-bottom: 2.5rem;
	}
	.cv-name {
		font: 400 clamp(64px, 10vw, 120px) / 0.9 var(--serif);
		font-variation-settings: 'opsz' 96;
		letter-spacing: -0.03em;
	}
	.cv-years {
		margin-left: 0.1em;
		font: 400 0.16em/1 var(--serif);
		letter-spacing: 0;
		vertical-align: 2.8em;
	}
	.cv-contact {
		line-height: 1.8;
	}
	.cv-contact a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.cv-summary {
		max-width: 60ch;
		font: 400 clamp(20px, 2.2vw, 26px) / 1.35 var(--serif);
	}

	/* Each section: label on the left, content on the right, a hairline above. */
	.cv-sec {
		display: grid;
		grid-template-columns: 25% 1fr;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--ink);
	}
	.cv-label {
		padding-top: 0.35rem;
	}
	.cv-body {
		display: grid;
		gap: 1.25rem;
	}
	.cv-item {
		display: grid;
		gap: 0.4rem;
	}
	.cv-item-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.cv-item-title {
		font: 400 22px/1.25 var(--serif);
	}
	.cv-dates {
		flex: none;
	}
	.cv-text {
		max-width: 60ch;
	}
	.cv-points {
		display: grid;
		gap: 0.3rem;
		max-width: 60ch;
	}
	.cv-skills {
		gap: 0.9rem;
	}
	.cv-skill {
		display: grid;
		gap: 0.15rem;
	}

	@media (max-width: 767px) {
		.cv-bar {
			padding: 1rem 1.25rem;
		}
		.cv {
			padding: 1.5rem 1.25rem 4rem;
		}
		.cv-sec {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}

	/* One A4 page: no bar or buttons, white paper, slightly smaller type. */
	@page {
		size: A4;
		margin: 12mm;
	}
	@media print {
		:global(html),
		:global(body) {
			background: #fff;
		}
		.cv-bar {
			display: none;
		}
		.cv {
			max-width: none;
			padding: 0;
		}
		.cv-name {
			font-size: 54px;
		}
		.cv-summary {
			font-size: 15px;
		}
		.cv-sec {
			padding: 0.7rem 0;
			break-inside: avoid;
		}
		.cv-item-title {
			font-size: 15px;
		}
		.cv-text,
		.cv-points {
			font-size: 11.5px;
			line-height: 1.5;
		}
		.cv-contact a {
			text-decoration: none;
		}
	}
</style>
