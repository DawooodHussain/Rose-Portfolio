---
/*
 * Design demo of docs/DESIGN.md ("Marigold Edition"): hero, About scroll story (with the facts
 * screen), Hello. Shared tokens and resets come from src/styles/base.css; everything else for
 * this page (markup, <style is:global>, inline scripts) lives here. /resume is resume.astro.
 * noindex while it's a demo. The live portfolio is the separate ../frontend project.
 */
import { profile } from '../data/profile';
import { facts } from '../data/resume';
import Fonts from '../components/Fonts.astro';
import '../styles/base.css';

const years = '02';
// "GitHub GitHub …" line for the stat screen, split into letters so each can ride the wave.
const marqueeWords = Array.from({ length: 6 }, () => 'GitHub');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Demo — Marigold Edition</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<Fonts />
		<script is:inline>
			history.scrollRestoration = 'manual';
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
		</script>
	</head>
	<body>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<defs>
				<symbol id="star" viewBox="0 0 24 24">
					<path d="M12 1v22M2.47 6.5l19.06 11M2.47 17.5l19.06-11" fill="none" stroke="currentColor" stroke-linecap="round" style="stroke-width: var(--star-stroke, 1)"></path>
				</symbol>
			</defs>
		</svg>

		<!-- Chevron wipe: the page transition into About (click or scroll down from the hero) and into Hello. -->
		<div class="wipe wipe-about" aria-hidden="true">
			<!-- Copies of the About title and the sweeping rose, at their exact on-arrival positions, so the
			     arrow edge reveals them gradually and the hand-off after the jump is invisible. -->
			<img class="flower flower-sweep" src="/flowers/rose.webp" width="1003" height="1400" alt="" decoding="async" />
			<p class="about-title wipe-title"><span class="word-mask"><span class="word">about</span></span><sup>(daud)</sup></p>
		</div>
		<!-- Same wipe in marigold for Hello. The script fills it with a copy of the Hello screen's content. -->
		<div class="wipe wipe-hello sec marigold hello" aria-hidden="true" inert></div>

		<!-- ============ HERO (marigold) ============ -->
		<section class="sec marigold hero" id="top">
			<nav class="nav" aria-label="Primary">
				<ul class="nav-group">
					<li><a href="#about" class="nav-link">About</a></li>
					<li><a href="#hello" class="nav-link">Hello</a></li>
				</ul>
				<ul class="nav-group right">
					<li><a href={profile.github} class="nav-link" target="_blank" rel="noreferrer">GitHub</a></li>
					{profile.linkedin && <li><a href={profile.linkedin} class="nav-link" target="_blank" rel="noreferrer">LinkedIn</a></li>}
					{profile.resume && <li><a href={profile.resume} class="nav-link">Resume</a></li>}
				</ul>
				<button class="nav-link menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
			</nav>

			<!-- The asterisk belongs to the hero: pinned to its top centre, it scrolls away with it (not fixed like the nav). -->
				<a href="#top" class="mark" aria-label={`${profile.name}, home`}><svg><use href="#star"></use></svg></a>

			<!-- Mobile menu overlay -->
			<div class="menu milk" id="menu" hidden>
				<button class="nav-link menu-close" type="button">Close</button>
				<ul>
					<li><a href="#about">About</a></li>
					<li><a href="#hello">Hello</a></li>
					<li><a href={profile.github} target="_blank" rel="noreferrer">GitHub</a></li>
					{profile.linkedin && <li><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>}
					{profile.resume && <li><a href={profile.resume}>Resume</a></li>}
				</ul>
			</div>

			<h1 class="name-wrap">
				<span class="name"><span class="word-mask"><span class="word">{profile.name}</span></span><sup class="years" aria-hidden="true">({years})</sup></span>
			</h1>

			<div class="corner-cols">
				<p class="micro">Java developer and full stack builder,<br />living and working in Lahore, Pakistan.</p>
				<p class="micro">A big passion for chess, books,<br />and software that feels simple.</p>
			</div>
		</section>

		<!--
			============ ABOUT (rose-milk): two full screens that scroll normally ============
			1. Intro: "about (daud)" centred, the rose beneath it.
			2. Main:  oval + sentence, with the hanging and peeking roses.
			Flowers: "Pasture Rose" by Pierre-Joseph Redouté, watercolor, Cleveland Museum of Art,
			CC0 public domain (1959.15). Cut out with scripts/cutout-flower.mjs. Decorative only.
		-->
		<section class="about-screen about-intro" id="about" aria-labelledby="about-title">
			<img class="flower flower-sweep" src="/flowers/rose.webp" width="1003" height="1400" alt="" aria-hidden="true" decoding="async" />
			<h2 class="about-title" id="about-title"><span class="word-mask"><span class="word">about</span></span><sup aria-hidden="true">(daud)</sup></h2>
		</section>

		<section class="about-screen about-main" aria-label="About Daud">
			<div class="about-body">
				<!-- Chessboard oval: stands in for a portrait, and nods to the chess habit. -->
				<!--
					Photos: Cleveland Museum of Art, CC0 public domain. Oval: "View of the City of Lahore Taken from
					the Roof of the Palace" (1863–70, 2024.5.26), with the Badshahi Mosque. Inline: Wazir Khan Mosque
					minaret from "The City of Lahore. Another View…" (2024.5.27); "Mirror Case with a Couple Playing
					Chess" (1325–50, 1940.1200).
				-->
				<div class="about-oval">
					<img src="/photos/lahore-badshahi.webp" width="900" height="708" alt="Lahore in the 1860s, with the Badshahi Mosque on the skyline" decoding="async" />
				</div>
				<p class="about-para">
					Java developer and student, living and working in Lahore<img class="inline-pic" src="/photos/lahore-minaret.webp" width="160" height="160" alt="" aria-hidden="true" />,
					Pakistan. A big passion for chess<img class="inline-pic" src="/photos/chess.webp" width="160" height="160" alt="" aria-hidden="true" />,
					philosophy, and a good series.
				</p>
			</div>
			<span class="page-no" aria-hidden="true">{years}</span>
		</section>

		<!-- ============ FACTS (rose): the short résumé, last page of the About chapter; links to /resume ============ -->
		<section class="sec facts" id="facts" aria-labelledby="facts-title">
			<h2 class="visually-hidden" id="facts-title">At a glance</h2>
			<dl class="facts-list">
				{
					facts.map((f, i) => (
						<div class="fact" style={`--i: ${i}`}>
							<dt class="micro">{f.label}</dt>
							<dd class="fact-value">{f.value}</dd>
						</div>
					))
				}
			</dl>
			<a class="btn facts-btn" href={profile.resume}>
				Full resume
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"></path></svg>
			</a>
			<p class="micro facts-corner">Open to freelance work</p>
			<span class="page-no" aria-hidden="true">03</span>
		</section>

		<!-- One asterisk for the caption + stat screens: travels bottom → top between them, rotating with the scroll. -->
		<svg class="roam-mark" aria-hidden="true"><use href="#star"></use></svg>

		<!-- ============ CAPTION INTERLUDE: hanging rose, two-column caption, asterisk ============ -->
		<section class="about-screen interlude" aria-label="What Daud builds">
			<!-- White rose leaves (from the same Redouté print), carried in from the left by the wind. Filled by the script. -->
			<div class="leaf-field" aria-hidden="true"></div>
			<div class="caption-cols">
				<p class="micro">Building fast, modern web apps</p>
				<p class="micro">with Java, React, Node.js, and Python.</p>
			</div>
		</section>

		<!--
			============ STAT + GITHUB LINE: pinned scroll moment ============
			250svh tall with a pinned stage. Scroll raises the "GitHub" line and drops "02" into it;
			the splash and ripples after the impact are a real-time water simulation (see the script).
		-->
		<section class="stat-story" aria-label="Experience">
			<div class="stat-stage">
				<p class="stat"><span class="stat-num">{years}</span><span class="stat-label">Years building for the web</span></p>
				<a class="marquee" href={profile.github} target="_blank" rel="noreferrer" aria-label={`${profile.name} on GitHub`}>
					<span class="mq-track" aria-hidden="true">
						{
							marqueeWords.map((w) => (
								<span class="mq-word">
									{[...w].map((ch) => (
										<span class="mq-ch">{ch}</span>
									))}
								</span>
							))
						}
					</span>
				</a>
			</div>
		</section>

		<!-- ============ HELLO (marigold): the closing contact screen ============ -->
		<section class="sec marigold hello" id="hello" aria-labelledby="hello-title">
			<div class="hello-inner">
				<h2 class="hello-title" id="hello-title"><span class="word-mask"><span class="word" style="--i: 0">Let's</span></span> <span class="word-mask"><span class="word" style="--i: 1">build</span></span> <span class="word-mask"><span class="word" style="--i: 2">something</span></span></h2>
				<p class="hello-email">{profile.email}</p>
				<div class="hello-actions">
					<a class="btn" href={`mailto:${profile.email}`}>
						Say hello
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"></path></svg>
					</a>
					<button class="text-btn" type="button" data-copy={profile.email}>Copy email</button>
				</div>
			</div>
			<div class="hello-corners">
				<p class="micro">Based in Lahore · Open to freelance work</p>
				<p class="micro">© {profile.year} {profile.name}</p>
			</div>
		</section>

		<script is:inline>
			// The sentence fades up once, the first time it scrolls into view.
			const revealIO = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						e.target.classList.add('in');
						revealIO.unobserve(e.target);
					}
				},
				{ threshold: 0.3 },
			);
			revealIO.observe(document.querySelector('.about-para'));
			revealIO.observe(document.querySelector('.facts'));

			// Nav active state: "About" gets its oval outline while any About-area screen is in view.
			const aboutLink = document.querySelector('.nav-group a[href="#about"]');
			const aboutAreas = document.querySelectorAll('.about-screen, .stat-story, .facts');
			const inView = new Set();
			const navIO = new IntersectionObserver(
				(entries) => {
					for (const e of entries) e.isIntersecting ? inView.add(e.target) : inView.delete(e.target);
					aboutLink.setAttribute('aria-current', String(inView.size > 0));
				},
				{ rootMargin: '-45% 0px -55% 0px' },
			);
			aboutAreas.forEach((el) => navIO.observe(el));
			const helloLink = document.querySelector('.nav-group a[href="#hello"]');
			new IntersectionObserver(
				([e]) => helloLink.setAttribute('aria-current', String(e.isIntersecting)),
				{ rootMargin: '-45% 0px -55% 0px' },
			).observe(document.getElementById('hello'));

			// Nav colour: milk while a dark-chapter screen is under the nav (a thin band at the top of the screen).
			const darkUnderNav = new Set();
			const darkIO = new IntersectionObserver(
				(entries) => {
					for (const e of entries) e.isIntersecting ? darkUnderNav.add(e.target) : darkUnderNav.delete(e.target);
					document.documentElement.classList.toggle('on-dark', darkUnderNav.size > 0);
				},
				{ rootMargin: '0px 0px -95% 0px' },
			);
			document.querySelectorAll('.interlude, .stat-story').forEach((el) => darkIO.observe(el));

			// Falling leaves on the caption screen: a tiny physics loop, not keyframes.
			//  - A strong gust throws each leaf in from the left; air drag bleeds that speed off smoothly
			//    until only a light breeze carries it (no stop, just slowing down).
			//  - Gravity pulls it down slowly, to a low terminal speed, like a light leaf.
			//  - Flutter: it swings side to side, tilts into each swing and flips in 3D while it falls.
			// Leaves enter from the left edge and are recycled once they leave the screen.
			// Runs only while the screen is visible; skipped under reduced motion.
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const field = document.querySelector('.leaf-field');
				const srcs = ['/flowers/leaf-a.webp', '/flowers/leaf-b.webp', '/flowers/leaf-c.webp'];
				const rand = (a, b) => a + Math.random() * (b - a);
				const leaves = Array.from({ length: 7 }, (_, i) => {
					const img = new Image();
					img.src = srcs[i % srcs.length];
					img.alt = '';
					field.append(img);
					return { img };
				});
				const spawn = (l, W, H, wait) => {
					l.size = rand(26, 52) * (l.img.src.includes('leaf-b') ? 1.4 : 1);
					l.img.style.width = `${l.size.toFixed(0)}px`;
					l.x = -l.size * 2;
					l.wait = wait; // seconds before its gust, so they arrive one by one
					l.img.style.transform = `translate3d(${l.x}px, 0, 0)`;
					l.y = rand(0.02, 0.4) * H;
					l.vx = rand(700, 1150); // the gust
					l.vy = rand(-15, 0);
					l.fall = rand(22, 40); // terminal falling speed, px/s
					l.phase = rand(0, Math.PI * 2);
					l.freq = rand(1.4, 2.6); // flutter, rad/s
					l.swing = rand(14, 30); // side-to-side swing, px
					l.tilt = rand(-40, 40);
					l.flipK = rand(0.5, 0.9);
				};
				let W = 0, H = 0, t = 0, last = 0, raf = 0;
				const size = () => ({ width: W, height: H } = field.getBoundingClientRect());
				const step = (now) => {
					const dt = Math.min(0.05, (now - (last || now)) / 1000);
					last = now;
					t += dt;
					// After the gust: a light breeze that slowly swells and fades.
					const wind = 22 + 12 * Math.sin(t * 0.37) + 6 * Math.sin(t * 0.91 + 1.3);
					for (const l of leaves) {
						if (l.wait > 0) {
							l.wait -= dt;
							continue;
						}
						l.phase += l.freq * dt;
						const s = Math.sin(l.phase);
						l.vx += (wind - l.vx) * 1.3 * dt; // air drag
						// Falls faster mid-swing, slower (even lifts a little) at the ends of each swing.
						l.vy += (l.fall * (1 - 0.6 * Math.abs(Math.cos(l.phase))) - l.vy) * 0.8 * dt;
						l.x += l.vx * dt;
						l.y += l.vy * dt;
						const x = l.x + l.swing * s;
						const rot = l.tilt + 28 * Math.cos(l.phase);
						const flipX = 55 * Math.sin(l.phase * l.flipK);
						const flipY = 35 * Math.cos(l.phase * 0.6);
						l.img.style.transform = `translate3d(${x.toFixed(1)}px, ${l.y.toFixed(1)}px, 0) rotate(${rot.toFixed(1)}deg) rotateX(${flipX.toFixed(1)}deg) rotateY(${flipY.toFixed(1)}deg)`;
						if (l.x > W + l.size * 2 || l.y > H + l.size * 2) spawn(l, W, H, rand(0.5, 4));
					}
					raf = requestAnimationFrame(step);
				};
				size();
				leaves.forEach((l, i) => spawn(l, W, H, i * rand(0.5, 1.1)));
				addEventListener('resize', size);
				new IntersectionObserver(([e]) => {
					cancelAnimationFrame(raf);
					last = 0;
					if (e.isIntersecting) raf = requestAnimationFrame(step);
				}).observe(field);
			}

			const statStory = document.querySelector('.stat-story');
			const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const clamp01 = (v) => Math.min(1, Math.max(0, v));
			const roam = document.querySelector('.roam-mark');
			const interlude = document.querySelector('.interlude');
			const placeRoam = () => {
				const vh = innerHeight;
				// Unrotated size (the bounding box of a rotated star is larger).
				const size = roam.clientHeight || 56;
				const bottomY = vh - 40 - size;
				const topY = 16;
				const start = interlude.offsetTop;
				const end = statStory.offsetTop + statStory.offsetHeight - vh;
				const y0 = scrollY;
				let y;
				if (y0 < start) y = bottomY + (start - y0); // arriving with the caption screen
				else if (y0 < start + vh) y = bottomY + (topY - bottomY) * ((y0 - start) / vh); // bottom → top
				else if (y0 <= end) y = topY; // sits at the top of the stat screen
				else y = topY - (y0 - end); // leaves with the stat screen
				// One full turn during the bottom → top travel, so it's upright whenever a screen is at rest.
				const rot = reducedMotion ? 0 : clamp01((y0 - start) / vh) * 360;
				roam.style.transform = `translate(-50%, ${y.toFixed(1)}px) rotate(${rot.toFixed(1)}deg)`;
			};

			// Stat screen: "02" drops into the GitHub line like a stone into water.
			// Scroll is only the camera: it raises the line and lets "02" fall (smoothed, so wheel steps
			// glide). Everything after the impact runs in real time, like real water, even if you stop:
			//  - The line is a simulated water surface (a 1D wave equation). The impact dips it and the
			//    rebound travels outward as ripples that lose energy and settle flat.
			//  - "02" keeps sinking under the surface, slowed by drag, until it's gone.
			//  - A crown of ink drops and the letters right under the impact are thrown up. They fly
			//    under gravity, and each one sends out its own small ripple where it lands. The letters
			//    then drift back into line.
			// The loop runs only while the screen is visible and stops itself once the water is still.
			const stage = statStory.querySelector('.stat-stage');
			const track = statStory.querySelector('.mq-track');
			const marquee = statStory.querySelector('.marquee');
			const letters = [...statStory.querySelectorAll('.mq-ch')];
			const num = statStory.querySelector('.stat-num');
			const label = statStory.querySelector('.stat-label');
			const stat = statStory.querySelector('.stat');
			const rnd = (a, b) => a + Math.random() * (b - a);
			const smooth = (t) => t * t * (3 - 2 * t);
			const P_FALL = 0.06; // "02" starts to fall
			const P_HIT = 0.4; // "02" meets the surface

			let W = innerWidth;
			let H = innerHeight;
			let lefts = [];
			let numTop0 = 0;
			let numH = 0;
			let numW = 0;
			let fontPx = 0;
			let trackW = 0;

			// Water surface: N points spanning the screen plus a margin each side, where extra damping
			// (a "sponge") absorbs the waves so they leave the screen instead of bouncing back.
			const N = 220;
			const h = new Float32Array(N); // height, + is down
			const v = new Float32Array(N);
			let x0 = 0;
			let dx = 1;
			const hAt = (x) => {
				const f = (x - x0) / dx;
				const i = Math.floor(f);
				if (i < 0 || i >= N - 1) return 0;
				const t = f - i;
				return h[i] * (1 - t) + h[i + 1] * t;
			};
			const disturb = (x, width, dh, dv) => {
				for (let i = 0; i < N; i++) {
					const d = (x0 + i * dx - x) / width;
					if (d > 3 || d < -3) continue;
					const g = Math.exp(-d * d);
					h[i] += dh * g;
					v[i] += dv * g;
				}
			};
			const STEP = 1 / 120;
			const stepWater = () => {
				const c = 0.45 * W; // wave speed, px/s
				const c2 = (c * c) / (dx * dx);
				for (let i = 0; i < N; i++) {
					const l = i > 0 ? h[i - 1] : h[i];
					const r = i < N - 1 ? h[i + 1] : h[i];
					const xi = x0 + i * dx;
					const edge = xi < 0 ? xi / x0 : xi > W ? (xi - W) / -x0 : 0;
					v[i] += (c2 * (l + r - 2 * h[i]) - 6 * h[i] - (2 + 16 * edge) * v[i]) * STEP;
				}
				for (let i = 0; i < N; i++) h[i] += v[i] * STEP;
			};

			// Ink drops: a small pool of spans, reused.
			const spray = document.createElement('div');
			spray.className = 'spray';
			spray.setAttribute('aria-hidden', 'true');
			stage.append(spray);
			const drops = Array.from({ length: 32 }, () => {
				const el = document.createElement('span');
				el.className = 'drop';
				spray.append(el);
				return { el, alive: false };
			});
			const gravity = () => 3.4 * H; // px/s²
			// Throws drops up and outward from x; strength 0..1 sets how many and how high.
			const splash = (x, y, spread, strength) => {
				const count = Math.round(4 + 12 * strength);
				for (let k = 0; k < count; k++) {
					const d = drops.find((o) => !o.alive);
					if (!d) return;
					const side = k % 2 ? 1 : -1;
					const angle = side * rnd(0.12, 0.95); // from vertical, outward
					const speed = Math.sqrt(2 * gravity() * H * rnd(0.03, 0.2) * strength);
					d.alive = true;
					d.x = x + side * rnd(0, spread);
					d.y = y;
					d.vx = Math.sin(angle) * speed;
					d.vy = -Math.cos(angle) * speed;
					d.size = rnd(3, 9) * (0.6 + 0.4 * strength);
					d.el.style.width = d.el.style.height = `${d.size.toFixed(1)}px`;
					d.el.style.opacity = '1';
				}
			};

			// Letters thrown by the impact: offset from their slot, with their own velocity and spin.
			const fly = letters.map(() => null);
			let jetAt = -1;
			const throwLetters = () => {
				const shift = pSmooth * 0.22 * trackW;
				const cx = W / 2;
				letters
					.map((el, i) => ({ i, d: lefts[i] - shift - cx }))
					.filter((o) => Math.abs(o.d) < numW * 0.55)
					.sort((a, b) => Math.abs(a.d) - Math.abs(b.d))
					.slice(0, 3)
					.forEach(({ i, d }, rank) => {
						const side = Math.sign(d) || 1;
						const height = H * (rank === 0 ? rnd(0.22, 0.28) : rnd(0.11, 0.17));
						fly[i] = {
							x: 0,
							y: 0,
							vx: side * W * (rank === 0 ? rnd(0.005, 0.02) : rnd(0.05, 0.09)),
							vy: -Math.sqrt(2 * gravity() * height),
							rot: 0,
							vr: side * (rank === 0 ? rnd(20, 60) : rnd(120, 280)),
							landed: false,
						};
					});
			};

			// "02": scroll-linked until it meets the water, then real-time.
			let under = false;
			let sinkY = 0;
			let sinkV = 0;

			const measure = () => {
				W = innerWidth;
				H = innerHeight;
				lefts = letters.map((el) => el.offsetLeft + el.offsetWidth / 2);
				stat.style.setProperty('--sink', '0px');
				const stageTop = stage.getBoundingClientRect().top;
				const r = num.getBoundingClientRect();
				numTop0 = r.top - stageTop;
				numH = r.height;
				numW = r.width;
				fontPx = parseFloat(getComputedStyle(marquee).fontSize);
				trackW = track.scrollWidth;
				x0 = -0.25 * W;
				dx = (1.5 * W) / (N - 1);
				h.fill(0);
				v.fill(0);
			};

			let pTarget = 0;
			let pSmooth = 0;
			let raf = 0;
			let last = 0;
			let acc = 0;
			let visible = false;
			const tick = (now) => {
				const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
				last = now;
				const cx = W / 2;
				const g = gravity();

				// Camera: the smoothed scroll progress.
				pSmooth += (pTarget - pSmooth) * (1 - Math.exp(-dt * 7));
				if (Math.abs(pTarget - pSmooth) < 0.0002) pSmooth = pTarget;
				const lineY = (0.82 - 0.32 * smooth(Math.min(1, pSmooth / 0.42))) * H;
				statStory.style.setProperty('--line-y', (lineY / H).toFixed(4));
				const surface = lineY - fontPx * 0.42; // the top of the letters is the water surface
				label.style.opacity = String(1 - Math.min(1, Math.max(0, (pSmooth - 0.04) / 0.1)));

				// Water, in fixed steps so it behaves the same at any frame rate.
				acc += dt;
				while (acc >= STEP) {
					stepWater();
					acc -= STEP;
				}

				// "02".
				const fall = Math.max(0, surface - (numTop0 + numH));
				if (!under && pSmooth >= P_HIT) {
					// Impact: dip the surface under "02", throw a crown of drops, then the letters.
					under = true;
					sinkY = fall;
					sinkV = 0.9 * H;
					disturb(cx, numW * 0.33, 0.035 * H, 0.6 * H);
					splash(cx, surface, numW * 0.4, 1);
					jetAt = now + 90; // the rebound jet comes a beat after the dip
				} else if (under && pSmooth < P_HIT - 0.03) {
					under = false; // scrolled back up: "02" rises out again
				}
				if (under) {
					if (numTop0 + sinkY < surface + numH * 0.2) {
						sinkV = Math.max(0.12 * H, sinkV - 3 * sinkV * dt); // drag, never quite stopping
						sinkY += sinkV * dt;
					}
				}
				let rising = false;
				if (!under) {
					const t = Math.min(1, Math.max(0, (pSmooth - P_FALL) / (P_HIT - P_FALL)));
					const target = t * t * fall; // gravity: speeds up as it falls
					// Glides (instead of jumping) back up when you scroll up after it sank.
					sinkY = dt ? sinkY + (target - sinkY) * (1 - Math.exp(-dt * 8)) : target;
					rising = Math.abs(target - sinkY) > 0.5;
				}
				stat.style.setProperty('--sink', `${sinkY.toFixed(1)}px`);
				const hidden = numTop0 + sinkY + numH - (surface + hAt(cx));
				num.style.clipPath = `inset(-10% -10% ${Math.min(numH + 4, Math.max(0, hidden)).toFixed(1)}px -10%)`;
				if (jetAt > 0 && now >= jetAt) {
					jetAt = -1;
					throwLetters();
				}

				// Drops: fly, stretch along their path, and make a tiny ripple where they land.
				let busy = false;
				for (const d of drops) {
					if (!d.alive) continue;
					busy = true;
					d.vy += g * dt;
					d.x += d.vx * dt;
					d.y += d.vy * dt;
					if (d.vy > 0 && d.y >= surface + hAt(d.x)) {
						d.alive = false;
						d.el.style.opacity = '0';
						disturb(d.x, 0.01 * W, 0.0006 * H * d.size, 0);
						continue;
					}
					const speed = Math.hypot(d.vx, d.vy);
					const stretch = 1 + Math.min(1.4, speed / (2.2 * H));
					const angle = (Math.atan2(d.vy, d.vx) * 180) / Math.PI - 90;
					d.el.style.transform = `translate3d(${(d.x - d.size / 2).toFixed(1)}px, ${(d.y - d.size / 2).toFixed(1)}px, 0) rotate(${angle.toFixed(1)}deg) scale(${(1 / Math.sqrt(stretch)).toFixed(3)}, ${stretch.toFixed(3)})`;
				}

				// Letters ride the surface; thrown ones fly, land, then drift back into their slot.
				const shift = pSmooth * 0.22 * trackW;
				track.style.transform = `translate3d(${(-shift).toFixed(1)}px, 0, 0)`;
				letters.forEach((el, i) => {
					const slot = lefts[i] - shift;
					const f = fly[i];
					let ox = 0;
					let oy;
					let spin = 0;
					if (f && !f.landed) {
						busy = true;
						f.vy += g * dt;
						f.x += f.vx * dt;
						f.y += f.vy * dt;
						f.rot += f.vr * dt;
						const water = hAt(slot + f.x);
						if (f.vy > 0 && f.y >= water) {
							f.landed = true;
							disturb(slot + f.x, 0.03 * W, 0.012 * H, 0.15 * H);
							splash(slot + f.x, surface + water, fontPx * 0.2, 0.3);
						}
						ox = f.x;
						oy = f.y;
						spin = f.rot;
					}
					if (f && f.landed) {
						busy = true;
						// Critically damped spring back to the slot (no overshoot, no hard stop).
						const w = 5;
						f.vx += (-w * w * f.x - 2 * w * f.vx) * dt;
						f.x += f.vx * dt;
						f.vr += (-w * w * f.rot - 2 * w * f.vr) * dt;
						f.rot += f.vr * dt;
						if (Math.abs(f.x) < 0.3 && Math.abs(f.rot) < 0.3 && Math.abs(f.vx) < 2) fly[i] = null;
						ox = f.x;
						spin = f.rot;
					}
					const x = slot + ox;
					const water = hAt(x);
					if (oy === undefined) oy = water;
					const slope = (Math.atan((hAt(x + 4) - hAt(x - 4)) / 8) * 180) / Math.PI;
					const rot = spin + Math.max(-25, Math.min(25, slope));
					el.style.transform = `translate3d(${ox.toFixed(1)}px, ${oy.toFixed(1)}px, 0) rotate(${rot.toFixed(2)}deg)`;
				});

				// Keep going while anything still moves; stop once the water is still.
				let energy = 0;
				for (let i = 0; i < N; i++) energy = Math.max(energy, Math.abs(h[i]), Math.abs(v[i]) * 0.1);
				const sinking = under && numTop0 + sinkY < surface + numH * 0.2;
				if (busy || sinking || rising || jetAt > 0 || energy > 0.15 || pSmooth !== pTarget) {
					raf = visible ? requestAnimationFrame(tick) : 0;
				} else {
					h.fill(0);
					v.fill(0);
					raf = 0;
				}
				if (!raf) last = 0;
			};
			const run = () => {
				if (!raf && visible) raf = requestAnimationFrame(tick);
			};
			const updateStat = (instant) => {
				pTarget = Math.min(1, Math.max(0, (scrollY - statStory.offsetTop) / (statStory.offsetHeight - innerHeight)));
				if (instant) pSmooth = pTarget;
				run();
			};
			new IntersectionObserver(([e]) => {
				visible = e.isIntersecting;
				if (visible) run();
			}).observe(statStory);

			let queued = false;
			const frame = () => {
				queued = false;
				placeRoam();
				if (!reducedMotion) updateStat();
			};
			addEventListener(
				'scroll',
				() => {
					if (!queued) {
						queued = true;
						requestAnimationFrame(frame);
					}
				},
				{ passive: true },
			);
			const remeasure = () => {
				placeRoam();
				if (reducedMotion) return;
				measure();
				updateStat(true);
			};
			addEventListener('resize', remeasure);
			document.fonts.ready.then(remeasure);

			// Copy email: shows "Copied", or the address itself if the clipboard is blocked.
			document.querySelectorAll('[data-copy]').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const initial = btn.textContent;
					try {
						await navigator.clipboard.writeText(btn.dataset.copy);
						btn.textContent = 'Copied';
					} catch {
						btn.textContent = btn.dataset.copy;
					}
					setTimeout(() => (btn.textContent = initial), 2000);
				});
			});

			// In-page links scroll without adding #hash to the URL. Two of them play the chevron wipe:
			//  - About, from the hero (also when you scroll down from the hero)
			//  - Hello, from anywhere
			// The wipe covers the screen, the page jumps underneath it, and the wipe's copy of the
			// target's content hands off to the real one. Focus moves to the target for keyboard users.
			const root = document.documentElement;
			const hero = document.getElementById('top');
			const about = document.getElementById('about');
			const hello = document.getElementById('hello');
			const wipeHello = document.querySelector('.wipe-hello');
			for (const el of hello.querySelectorAll('.hello-inner, .hello-corners')) {
				const copy = el.cloneNode(true);
				copy.querySelectorAll('[id]').forEach((n) => n.removeAttribute('id'));
				wipeHello.append(copy);
			}
			const isReduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
			const atHero = () => scrollY < hero.offsetHeight / 2;
			const wiping = () => root.classList.contains('wiping');
			const focusTarget = (t) => {
				t.setAttribute('tabindex', '-1');
				t.focus({ preventScroll: true });
			};
			// A trackpad flick keeps sending wheel events after the fingers lift (momentum), with a
			// steadily shrinking delta. After a scroll-triggered wipe, swallow only that shrinking tail,
			// so the page doesn't fly past About. Any new scroll (a delta that grows again, as a fresh
			// swipe or a mouse-wheel click does) is let through at once. Clicks never lock.
			let momentumUntil = 0;
			let lastDelta = 0;
			const playWipe = (kind, target, fromScroll = false) => {
				root.dataset.wipe = kind;
				root.classList.add('wiping');
				document.querySelector(`.wipe-${kind}`).addEventListener(
					'animationend',
					() => {
						scrollTo({ top: target.offsetTop, behavior: 'instant' });
						root.classList.remove('wiping');
						momentumUntil = fromScroll ? performance.now() + 1200 : 0;
						focusTarget(target);
					},
					{ once: true },
				);
			};
			const goTo = (t) => {
				if (wiping()) return;
				if (!isReduced() && t === about && atHero()) playWipe('about', about);
				else if (!isReduced() && t === hello && Math.abs(scrollY - hello.offsetTop) > 4) playWipe('hello', hello);
				else {
					t.scrollIntoView({ behavior: isReduced() ? 'auto' : 'smooth' });
					focusTarget(t);
				}
			};
			document.addEventListener('click', (e) => {
				const a = e.target.closest('a[href^="#"]');
				const t = a && document.getElementById(a.hash.slice(1));
				if (!t) return;
				e.preventDefault();
				goTo(t);
			});
			// Scrolling down from the hero plays the About wipe instead of a plain scroll.
			const scrollFromHero = (e) => {
				e.preventDefault();
				if (!wiping()) playWipe('about', about, true);
			};
			addEventListener(
				'wheel',
				(e) => {
					const delta = Math.abs(e.deltaY);
					const isMomentum = delta < lastDelta || (delta <= 2 && lastDelta <= 2);
					lastDelta = delta;
					if (wiping()) return e.preventDefault(); // the 0.9s wipe itself: the page must stay still under it
					if (performance.now() < momentumUntil) {
						if (isMomentum) return e.preventDefault();
						momentumUntil = 0; // a real scroll: stop swallowing
					}
					if (e.deltaY > 0 && atHero() && !isReduced() && menu.hidden) scrollFromHero(e);
				},
				{ passive: false },
			);
			let touchY = null;
			addEventListener('touchstart', (e) => (touchY = e.touches[0].clientY), { passive: true });
			addEventListener(
				'touchmove',
				(e) => {
					if (wiping()) return e.preventDefault();
					if (touchY === null || !atHero() || isReduced() || !menu.hidden) return;
					if (touchY - e.touches[0].clientY > 24) {
						touchY = null;
						scrollFromHero(e);
					}
				},
				{ passive: false },
			);
			addEventListener('keydown', (e) => {
				const scrollKey = ['ArrowDown', 'PageDown', ' '].includes(e.key);
				if (!scrollKey || e.altKey || e.ctrlKey || e.metaKey) return;
				if (e.target.closest('button, input, textarea, select, [contenteditable]')) return;
				if (wiping()) return e.preventDefault();
				if (atHero() && !isReduced() && menu.hidden) scrollFromHero(e);
			});

			// Mobile menu: open/close, close on link click or Escape, return focus to the button.
			const menu = document.getElementById('menu');
			const menuBtn = document.querySelector('.menu-btn');
			const setMenu = (open) => {
				menu.hidden = !open;
				menuBtn.setAttribute('aria-expanded', String(open));
				document.body.style.overflow = open ? 'hidden' : '';
				if (open) menu.querySelector('a').focus();
				else menuBtn.focus();
			};
			menuBtn.addEventListener('click', () => setMenu(true));
			menu.querySelector('.menu-close').addEventListener('click', () => setMenu(false));
			menu.addEventListener('click', (e) => e.target.closest('a') && setMenu(false));
			addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && setMenu(false));
		</script>
	</body>
</html>

