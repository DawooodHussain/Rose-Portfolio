---
/*
 * Design demo of docs/DESIGN.md ("Marigold Edition"): hero, About scroll story (with the facts
 * screen), Hello. Each section is a component in src/components/home/, styled by
 * src/styles/home/ and animated by the modules in src/scripts/home/ (entry: main.ts).
 * /resume is resume.astro. The live portfolio is the separate ../frontend project.
 */
import Star from '../components/Star.astro';
import StarSprite from '../components/StarSprite.astro';
import About from '../components/home/About.astro';
import Facts from '../components/home/Facts.astro';
import Hello from '../components/home/Hello.astro';
import Hero from '../components/home/Hero.astro';
import Interlude from '../components/home/Interlude.astro';
import StatStory from '../components/home/StatStory.astro';
import Wipes from '../components/home/Wipes.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
---

<BaseLayout title="Demo — Marigold Edition">
	<script is:inline slot="head">
		history.scrollRestoration = 'manual';
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
	</script>

	<StarSprite />
	<Wipes />
	<Hero />
	<About />
	<Facts />
	<!-- One asterisk for the caption + stat screens: travels bottom → top between them, rotating with the scroll. -->
	<Star class="roam-mark" />
	<Interlude />
	<StatStory />
	<Hello />

	<script>
		import '../scripts/home/main';
	</script>
</BaseLayout>
